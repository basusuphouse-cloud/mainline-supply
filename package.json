{
  "name": "mainline-supply",
  "version": "1.0.0",
  "private": true,
  "description": "Demo storefront for a fictional plumbing and HVAC distributor, built for Playwright testing demos.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "node:version": "node -v",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:all-browsers": "ALL_BROWSERS=1 playwright test",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:4173",
    "trace": "playwright show-trace"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
